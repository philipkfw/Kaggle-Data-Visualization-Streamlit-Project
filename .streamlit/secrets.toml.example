# Optional. The dashboard runs WITHOUT any secrets, from the bundled snapshot in
# data/snapshot/ (DuckDB). Create .streamlit/secrets.toml (gitignored) only to use
# live Snowflake or to re-export the snapshot. On Streamlit Community Cloud, paste
# the same content into App settings -> Secrets.

[app]
data_backend = "duckdb"      # "duckdb" (bundled snapshot, default) or "snowflake" (live)

[snowflake]
account = "ORGNAME-ACCOUNTNAME"
user = "YOUR_USER"
role = "SYSADMIN"            # or a read-only REPORTER role (see README)
warehouse = "COMPUTE_WH"
database = "KAGGLE_DB"
schema = "GOLD"              # "DEV_GOLD" to point at the dbt dev target

# Key-pair authentication - use ONE of the following:
# 1) Local: path to the unencrypted PKCS#8 private key
private_key_file = "/Users/you/.snowflake/keys/rsa_key.p8"

# 2) Streamlit Community Cloud: the key contents (keep the BEGIN/END lines)
# private_key = """-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"""

# Optional, only if the key is encrypted:
# private_key_passphrase = ""
